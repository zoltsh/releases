#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

publication=""
expected_current_channel=""
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --publication)
            publication="${2:?missing value for --publication}"
            shift 2
            ;;
        --expected-current-channel)
            expected_current_channel="${2:?missing value for --expected-current-channel}"
            shift 2
            ;;
        *)
            printf 'error: unknown argument %s\n' "$1" >&2
            exit 2
            ;;
    esac
done

if [[ -z "$publication" || -z "$expected_current_channel" ]]; then
    printf 'usage: scripts/publish-zap --publication <directory> --expected-current-channel <file>\n' >&2
    exit 2
fi
if [[ ! -d "$publication" ]]; then
    printf 'error: publication directory does not exist: %s\n' "$publication" >&2
    exit 2
fi
if [[ ! -f "$expected_current_channel" ]]; then
    printf 'error: expected current channel does not exist: %s\n' "$expected_current_channel" >&2
    exit 2
fi
publication="$(cd "$publication" && pwd)"
expected_current_channel="$(cd "$(dirname "$expected_current_channel")" && pwd)/$(basename "$expected_current_channel")"

aws_cli="${ZOLT_PUBLISH_AWS:-aws}"
if ! command -v "$aws_cli" >/dev/null 2>&1; then
    printf 'error: zap publication requires the AWS CLI on PATH\n' >&2
    exit 2
fi
if ! command -v jq >/dev/null 2>&1; then
    printf 'error: zap publication requires jq on PATH\n' >&2
    exit 2
fi
if ! command -v sha256sum >/dev/null 2>&1; then
    printf 'error: zap publication requires sha256sum on PATH\n' >&2
    exit 2
fi

bucket="zolt-dist"
endpoint="https://nyc3.digitaloceanspaces.com"
immutable_cache="public, max-age=31536000, immutable"
mutable_cache="no-cache"

shopt -s nullglob
version_directories=("$publication"/artifacts/zap/*)
shopt -u nullglob
if [[ "${#version_directories[@]}" -ne 1 || ! -d "${version_directories[0]}" ]]; then
    printf 'error: publication must contain exactly one artifacts/zap version directory\n' >&2
    exit 2
fi
version_directory="${version_directories[0]}"
version="$(basename "$version_directory")"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+-zap\.[0-9]{8}\.[0-9a-f]{12}$ ]]; then
    printf 'error: invalid staged zap version: %s\n' "$version" >&2
    exit 2
fi

expected_files=(
    "$version_directory/release-manifest.json"
    "$version_directory/release-record.json"
    "$version_directory/source-run.json"
    "$publication/channels/zap.json"
    "$publication/channels/zap.json.sig"
    "$publication/releases/zap.json"
    "$publication/releases/zap.json.sig"
)
for target in linux-arm64 linux-x64 macos-arm64 macos-x64; do
    archive="$version_directory/zolt-${version}-${target}.tar.gz"
    expected_files+=("$archive" "$archive.sha256")
done
for file in "${expected_files[@]}"; do
    if [[ ! -f "$file" ]]; then
        printf 'error: staged publication file is missing: %s\n' "$file" >&2
        exit 1
    fi
done
if [[ "$(jq -er '.version' "$publication/channels/zap.json")" != "$version" \
    || "$(jq -er '.versions[0].version' "$publication/releases/zap.json")" != "$version" \
    || "$(jq -er '.version' "$version_directory/release-record.json")" != "$version" ]]; then
    printf 'error: staged zap metadata does not match version directory %s\n' "$version" >&2
    exit 1
fi
if [[ "$(jq -er '.channel' "$publication/channels/zap.json")" != "zap" \
    || "$(jq -er '.channel' "$publication/releases/zap.json")" != "zap" \
    || "$(jq -er '.channel' "$version_directory/release-record.json")" != "zap" \
    || "$(jq -er '.state' "$version_directory/release-record.json")" != "candidate" ]]; then
    printf 'error: staged zap metadata has the wrong channel or release-record state\n' >&2
    exit 1
fi
if [[ "$(jq -er '.artifacts | length' "$publication/channels/zap.json")" -ne 4 ]]; then
    printf 'error: staged zap channel must contain four target artifacts\n' >&2
    exit 1
fi
for sidecar in "$publication/channels/zap.json.sig" "$publication/releases/zap.json.sig"; do
    if [[ "$(awk -F ': ' '$1 == "version" { print $2 }' "$sidecar")" != "zolt-ed25519-v1" \
        || "$(awk -F ': ' '$1 == "keyId" { print $2 }' "$sidecar")" != "zolt-release-2026" \
        || -z "$(awk -F ': ' '$1 == "signature" { print $2 }' "$sidecar")" ]]; then
        printf 'error: staged release signature has the wrong format or key: %s\n' "$sidecar" >&2
        exit 1
    fi
done
for target in linux-arm64 linux-x64 macos-arm64 macos-x64; do
    archive="zolt-${version}-${target}.tar.gz"
    expected_digest="$(awk '{ print $1; exit }' "$version_directory/$archive.sha256")"
    actual_digest="$(sha256sum "$version_directory/$archive" | awk '{ print $1 }')"
    if [[ ! "$expected_digest" =~ ^[0-9a-f]{64}$ || "$expected_digest" != "$actual_digest" ]]; then
        printf 'error: staged archive checksum mismatch: %s\n' "$archive" >&2
        exit 1
    fi
done
if find "$publication" -type l -print -quit | grep -q .; then
    printf 'error: staged publication must not contain symbolic links\n' >&2
    exit 1
fi
actual_count=0
while IFS= read -r file; do
    actual_count=$((actual_count + 1))
    found=0
    for expected in "${expected_files[@]}"; do
        if [[ "$file" == "$expected" ]]; then
            found=1
            break
        fi
    done
    if [[ "$found" -ne 1 ]]; then
        printf 'error: unexpected staged publication file: %s\n' "$file" >&2
        exit 1
    fi
done < <(find "$publication" -type f | sort)
if [[ "$actual_count" -ne "${#expected_files[@]}" ]]; then
    printf 'error: staged publication file count is incomplete\n' >&2
    exit 1
fi

aws() {
    "$aws_cli" --endpoint-url "$endpoint" "$@"
}

download_object() {
    local key="$1"
    local output="$2"
    aws s3api get-object --bucket "$bucket" --key "$key" "$output" >/dev/null
}

object_exists() {
    local key="$1"
    local error_file
    error_file="$(mktemp)"
    if aws s3api head-object --bucket "$bucket" --key "$key" >/dev/null 2>"$error_file"; then
        rm -f "$error_file"
        return 0
    fi
    if grep -Eq '\(404\)|Not Found|NoSuchKey' "$error_file"; then
        rm -f "$error_file"
        return 1
    fi
    printf 'error: could not inspect s3://%s/%s\n' "$bucket" "$key" >&2
    cat "$error_file" >&2
    rm -f "$error_file"
    exit 1
}

verify_remote_bytes() {
    local file="$1"
    local key="$2"
    local downloaded
    downloaded="$(mktemp)"
    if ! download_object "$key" "$downloaded"; then
        rm -f "$downloaded"
        printf 'error: could not read back s3://%s/%s\n' "$bucket" "$key" >&2
        exit 1
    fi
    if ! cmp -s "$file" "$downloaded"; then
        rm -f "$downloaded"
        printf 'error: remote bytes differ for s3://%s/%s\n' "$bucket" "$key" >&2
        exit 1
    fi
    rm -f "$downloaded"
}

publish_immutable() {
    local file="$1"
    local key="$2"
    local content_type="$3"
    if object_exists "$key"; then
        verify_remote_bytes "$file" "$key"
        printf 'Already published immutable s3://%s/%s\n' "$bucket" "$key"
        return
    fi
    if ! aws s3api put-object \
        --bucket "$bucket" \
        --key "$key" \
        --body "$file" \
        --acl public-read \
        --cache-control "$immutable_cache" \
        --content-type "$content_type" >/dev/null; then
        if object_exists "$key"; then
            verify_remote_bytes "$file" "$key"
            return
        fi
        printf 'error: could not publish immutable s3://%s/%s\n' "$bucket" "$key" >&2
        exit 1
    fi
    verify_remote_bytes "$file" "$key"
}

publish_mutable() {
    local file="$1"
    local key="$2"
    local content_type="$3"
    aws s3api put-object \
        --bucket "$bucket" \
        --key "$key" \
        --body "$file" \
        --acl public-read \
        --cache-control "$mutable_cache" \
        --content-type "$content_type" >/dev/null
    verify_remote_bytes "$file" "$key"
}

require_current_channel_unchanged() {
    local downloaded
    downloaded="$(mktemp)"
    if ! download_object "channels/zap.json" "$downloaded"; then
        rm -f "$downloaded"
        printf 'error: could not read the current zap channel from Spaces\n' >&2
        exit 1
    fi
    if ! cmp -s "$expected_current_channel" "$downloaded"; then
        rm -f "$downloaded"
        printf 'error: zap channel changed after publication preparation; refusing stale update\n' >&2
        exit 1
    fi
    rm -f "$downloaded"
}

require_current_channel_unchanged
for target in linux-arm64 linux-x64 macos-arm64 macos-x64; do
    archive="zolt-${version}-${target}.tar.gz"
    publish_immutable \
        "$version_directory/$archive" \
        "artifacts/zap/$version/$archive" \
        "application/gzip"
    publish_immutable \
        "$version_directory/$archive.sha256" \
        "artifacts/zap/$version/$archive.sha256" \
        "text/plain"
done
publish_immutable \
    "$version_directory/release-manifest.json" \
    "artifacts/zap/$version/release-manifest.json" \
    "application/json"
publish_immutable \
    "$version_directory/release-record.json" \
    "artifacts/zap/$version/release-record.json" \
    "application/json"
publish_immutable \
    "$version_directory/source-run.json" \
    "artifacts/zap/$version/source-run.json" \
    "application/json"

require_current_channel_unchanged
publish_mutable "$publication/releases/zap.json.sig" "releases/zap.json.sig" "text/plain"
publish_mutable "$publication/releases/zap.json" "releases/zap.json" "application/json"
publish_mutable "$publication/channels/zap.json.sig" "channels/zap.json.sig" "text/plain"
publish_mutable "$publication/channels/zap.json" "channels/zap.json" "application/json"

printf 'Published zap %s to s3://%s and changed channels/zap.json last\n' "$version" "$bucket"
