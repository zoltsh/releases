#!/usr/bin/env bash
set -euo pipefail

channel=""
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --channel)
            channel="${2:?missing value for --channel}"
            shift 2
            ;;
        *)
            printf 'error: unknown argument %s\n' "$1" >&2
            exit 2
            ;;
    esac
done

if [[ "$channel" != "zap" ]]; then
    printf 'usage: scripts/retire-legacy-installer --channel zap\n' >&2
    exit 2
fi
if [[ -z "${AWS_ACCESS_KEY_ID:-}" || -z "${AWS_SECRET_ACCESS_KEY:-}" ]]; then
    printf 'error: legacy installer retirement requires Spaces access credentials\n' >&2
    exit 2
fi

curl_cli="${ZOLT_PUBLISH_CURL:-curl}"
if ! command -v "$curl_cli" >/dev/null 2>&1; then
    printf 'error: legacy installer retirement requires curl on PATH\n' >&2
    exit 2
fi

endpoint="https://nyc3.digitaloceanspaces.com"
bucket="zolt-dist"
url="$endpoint/$bucket/install.sh"
spaces_curl() {
    "$curl_cli" \
        --proto '=https' \
        --tlsv1.2 \
        --fail \
        --silent \
        --show-error \
        --connect-timeout "${ZOLT_PUBLISH_CONNECT_TIMEOUT_SECONDS:-10}" \
        --max-time "${ZOLT_PUBLISH_TOTAL_TIMEOUT_SECONDS:-30}" \
        --aws-sigv4 "aws:amz:nyc3:s3" \
        --user "${AWS_ACCESS_KEY_ID}:${AWS_SECRET_ACCESS_KEY}" \
        "$@"
}

printf 'Deleting legacy mutable s3://%s/install.sh\n' "$bucket"
spaces_curl --request DELETE --output /dev/null "$url"

downloaded="$(mktemp)"
trap 'rm -f "$downloaded"' EXIT
status=""
if status="$(spaces_curl \
        --output "$downloaded" \
        --write-out '%{http_code}' \
        "$url" 2>/dev/null)"; then
    printf 'error: legacy mutable installer still exists after deletion\n' >&2
    exit 1
fi
if [[ "$status" != 404 ]]; then
    printf 'error: could not prove legacy mutable installer absence; authenticated GET returned HTTP %s\n' \
        "${status:-unknown}" >&2
    exit 1
fi

printf 'Retired legacy mutable installer; installation must use an immutable GitHub Release snapshot\n'
