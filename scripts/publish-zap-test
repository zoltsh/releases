#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT
store="$temporary/store"
log="$temporary/uploads.log"
fake_aws="$temporary/aws"
mkdir -p "$store/zolt-dist/channels"

cat > "$fake_aws" <<'FAKE_AWS'
#!/usr/bin/env bash
set -euo pipefail

if [[ "$1" == "--endpoint-url" ]]; then
    shift 2
fi
if [[ "$1" != "s3api" ]]; then
    exit 2
fi
operation="$2"
shift 2
bucket=""
key=""
body=""
output=""
if_none_match=""
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --bucket)
            bucket="$2"
            shift 2
            ;;
        --key)
            key="$2"
            shift 2
            ;;
        --body)
            body="$2"
            shift 2
            ;;
        --if-none-match)
            if_none_match="$2"
            shift 2
            ;;
        --acl | --cache-control | --content-type)
            shift 2
            ;;
        *)
            output="$1"
            shift
            ;;
    esac
done
path="$ZOLT_FAKE_AWS_ROOT/$bucket/$key"
case "$operation" in
    head-object)
        if [[ -f "$path" ]]; then
            printf '{}\n'
        else
            printf 'An error occurred (404) when calling HeadObject: Not Found\n' >&2
            exit 254
        fi
        ;;
    get-object)
        if [[ ! -f "$path" ]]; then
            exit 254
        fi
        cp "$path" "$output"
        printf '{}\n'
        ;;
    put-object)
        if [[ "$if_none_match" == "*" && -f "$path" ]]; then
            printf 'An error occurred (412) when calling PutObject: Precondition Failed\n' >&2
            exit 254
        fi
        mkdir -p "$(dirname "$path")"
        cp "$body" "$path"
        printf '%s\n' "$key" >> "$ZOLT_FAKE_AWS_LOG"
        printf '{}\n'
        ;;
    *)
        exit 2
        ;;
esac
FAKE_AWS
chmod +x "$fake_aws"

publication="$temporary/publication"
version="0.1.0-zap.20260803.aaaaaaaaaaaa"
version_directory="$publication/artifacts/zap/$version"
mkdir -p "$version_directory" "$publication/channels" "$publication/releases"
for target in linux-arm64 linux-x64 macos-arm64 macos-x64; do
    archive="$version_directory/zolt-${version}-${target}.tar.gz"
    printf 'archive-%s\n' "$target" > "$archive"
    digest="$(sha256sum "$archive" | awk '{ print $1 }')"
    printf '%s  %s\n' "$digest" "$(basename "$archive")" > "$archive.sha256"
done
printf '{}\n' > "$version_directory/release-manifest.json"
printf '{"channel":"zap","state":"candidate","version":"%s"}\n' "$version" \
    > "$version_directory/release-record.json"
printf '{}\n' > "$version_directory/source-run.json"
printf '{"channel":"zap","version":"%s","artifacts":[1,2,3,4]}\n' "$version" \
    > "$publication/channels/zap.json"
printf 'version: zolt-ed25519-v1\nkeyId: zolt-release-2026\nsignature: test\n' \
    > "$publication/channels/zap.json.sig"
printf '{"channel":"zap","versions":[{"version":"%s"}]}\n' "$version" \
    > "$publication/releases/zap.json"
printf 'version: zolt-ed25519-v1\nkeyId: zolt-release-2026\nsignature: test\n' \
    > "$publication/releases/zap.json.sig"

previous="$temporary/previous-channel.json"
printf '{"version":"previous"}\n' > "$previous"
cp "$previous" "$store/zolt-dist/channels/zap.json"

export ZOLT_FAKE_AWS_ROOT="$store"
export ZOLT_FAKE_AWS_LOG="$log"
export ZOLT_PUBLISH_AWS="$fake_aws"

scripts/publish-zap \
    --publication "$publication" \
    --expected-current-channel "$previous"
if [[ "$(tail -n 1 "$log")" != "channels/zap.json" ]]; then
    printf 'error: channel JSON was not uploaded last\n' >&2
    exit 1
fi
cmp "$publication/channels/zap.json" "$store/zolt-dist/channels/zap.json"

scripts/publish-zap \
    --publication "$publication" \
    --expected-current-channel "$publication/channels/zap.json" \
    > "$temporary/idempotent.log"

printf 'tampered\n' > "$version_directory/zolt-${version}-linux-x64.tar.gz"
tampered_digest="$(sha256sum "$version_directory/zolt-${version}-linux-x64.tar.gz" \
    | awk '{ print $1 }')"
printf '%s  %s\n' \
    "$tampered_digest" \
    "zolt-${version}-linux-x64.tar.gz" \
    > "$version_directory/zolt-${version}-linux-x64.tar.gz.sha256"
if scripts/publish-zap \
    --publication "$publication" \
    --expected-current-channel "$publication/channels/zap.json" \
    > "$temporary/tamper.log" 2>&1; then
    printf 'error: immutable zap overwrite was not refused\n' >&2
    exit 1
fi
if ! grep -q 'remote bytes differ' "$temporary/tamper.log"; then
    printf 'error: immutable zap overwrite failed for an unexpected reason\n' >&2
    cat "$temporary/tamper.log" >&2
    exit 1
fi

printf 'Zap Spaces publisher tests passed\n'
