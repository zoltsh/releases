#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

channel=""
publication=""
expected_current_channel=""
expect_current_absent=false
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --channel)
            channel="${2:?missing value for --channel}"
            shift 2
            ;;
        --publication)
            publication="${2:?missing value for --publication}"
            shift 2
            ;;
        --expected-current-channel)
            expected_current_channel="${2:?missing value for --expected-current-channel}"
            shift 2
            ;;
        --expect-current-absent)
            expect_current_absent=true
            shift
            ;;
        *)
            printf 'error: unknown argument %s\n' "$1" >&2
            exit 2
            ;;
    esac
done

if [[ -z "$channel" || -z "$publication" \
    || ( -z "$expected_current_channel" && "$expect_current_absent" != "true" ) \
    || ( -n "$expected_current_channel" && "$expect_current_absent" == "true" ) ]]; then
    printf 'usage: scripts/publish-channel-metadata --channel <zap|preview|stable> --publication <directory> (--expected-current-channel <file> | --expect-current-absent)\n' >&2
    exit 2
fi
case "$channel" in
    zap)
        expected_key_id="zolt-release-2026"
        tag_prefix="zolt-zap-"
        version_pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-zap\.[0-9]{8}\.[0-9a-f]{12}$'
        ;;
    preview)
        expected_key_id="zolt-preview-2026"
        tag_prefix="zolt-preview-v"
        version_pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-(alpha|beta|rc)\.(0|[1-9][0-9]*)$'
        ;;
    stable)
        expected_key_id="zolt-stable-2026"
        tag_prefix="zolt-v"
        version_pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
        ;;
    *)
        printf 'error: unsupported release channel: %s\n' "$channel" >&2
        exit 2
        ;;
esac
if [[ ! -d "$publication" \
    || ( -n "$expected_current_channel" && ! -f "$expected_current_channel" ) ]]; then
    printf 'error: publication directory and expected current channel must exist when provided\n' >&2
    exit 2
fi
publication="$(cd "$publication" && pwd)"
if [[ -n "$expected_current_channel" ]]; then
    expected_current_channel="$(cd "$(dirname "$expected_current_channel")" && pwd)/$(basename "$expected_current_channel")"
fi

curl_cli="${ZOLT_PUBLISH_CURL:-curl}"
if ! command -v "$curl_cli" >/dev/null 2>&1; then
    printf 'error: channel publication requires curl on PATH\n' >&2
    exit 2
fi
if ! command -v jq >/dev/null 2>&1; then
    printf 'error: channel publication requires jq on PATH\n' >&2
    exit 2
fi
if [[ -z "${AWS_ACCESS_KEY_ID:-}" || -z "${AWS_SECRET_ACCESS_KEY:-}" ]]; then
    printf 'error: channel publication requires Spaces access credentials\n' >&2
    exit 2
fi

bucket="zolt-dist"
endpoint="https://nyc3.digitaloceanspaces.com"
mutable_cache="no-cache"
channel_json="$publication/channels/$channel.json"
channel_signature="$publication/channels/$channel.json.sig"
index_json="$publication/releases/$channel.json"
index_signature="$publication/releases/$channel.json.sig"
for file in "$channel_json" "$channel_signature" "$index_json" "$index_signature"; do
    if [[ ! -f "$file" ]]; then
        printf 'error: staged channel metadata is missing: %s\n' "$file" >&2
        exit 1
    fi
done
if [[ "$(jq -er '.channel' "$channel_json")" != "$channel" \
    || "$(jq -er '.channel' "$index_json")" != "$channel" \
    || "$(jq -er '.versions[0].version' "$index_json")" != "$(jq -er '.version' "$channel_json")" ]]; then
    printf 'error: signed moving metadata does not match channel %s\n' "$channel" >&2
    exit 1
fi
if ! jq -e \
    --arg base "https://github.com/zoltsh/releases/releases/download/" \
    --arg tag_prefix "$tag_prefix" \
    --arg version_pattern "$version_pattern" '
    all(.versions[];
        . as $release
        | ($base + $tag_prefix + $release.version + "/") as $origin
        | ($release.version | test($version_pattern)) and all($release.artifacts[];
            (.archiveUrl == ($origin + .archive)) and
            (.checksumUrl == ($origin + .archive + ".sha256"))))
' "$index_json" >/dev/null; then
    printf 'error: signed moving metadata contains a non-GitHub release artifact\n' >&2
    exit 1
fi
for sidecar in "$channel_signature" "$index_signature"; do
    if [[ "$(awk -F ': ' '$1 == "version" { print $2 }' "$sidecar")" != "zolt-ed25519-v1" \
        || "$(awk -F ': ' '$1 == "keyId" { print $2 }' "$sidecar")" != "$expected_key_id" \
        || -z "$(awk -F ': ' '$1 == "signature" { print $2 }' "$sidecar")" ]]; then
        printf 'error: signed moving metadata has the wrong signature format or key: %s\n' "$sidecar" >&2
        exit 1
    fi
done

spaces_url() {
    printf '%s/%s/%s' "$endpoint" "$bucket" "$1"
}

spaces_curl() {
    "$curl_cli" \
        --proto '=https' \
        --tlsv1.2 \
        --fail \
        --silent \
        --show-error \
        --connect-timeout "${ZOLT_PUBLISH_CONNECT_TIMEOUT_SECONDS:-10}" \
        --max-time "${ZOLT_PUBLISH_TOTAL_TIMEOUT_SECONDS:-30}" \
        --aws-sigv4 "aws:amz:nyc3:s3" \
        --user "${AWS_ACCESS_KEY_ID}:${AWS_SECRET_ACCESS_KEY}" \
        "$@"
}

download_object() {
    local key="$1"
    local output="$2"
    printf 'Reading s3://%s/%s\n' "$bucket" "$key"
    spaces_curl --output "$output" "$(spaces_url "$key")"
}

verify_remote_bytes() {
    local file="$1"
    local key="$2"
    local downloaded
    downloaded="$(mktemp)"
    if ! download_object "$key" "$downloaded"; then
        rm -f "$downloaded"
        printf 'error: could not read back channel metadata s3://%s/%s\n' "$bucket" "$key" >&2
        exit 1
    fi
    if ! cmp -s "$file" "$downloaded"; then
        rm -f "$downloaded"
        printf 'error: remote channel metadata differs for s3://%s/%s\n' "$bucket" "$key" >&2
        exit 1
    fi
    rm -f "$downloaded"
}

publish_metadata() {
    local file="$1"
    local key="$2"
    local content_type="$3"
    printf 'Writing s3://%s/%s\n' "$bucket" "$key"
    spaces_curl \
        --request PUT \
        --upload-file "$file" \
        --header 'x-amz-acl: public-read' \
        --header "Cache-Control: $mutable_cache" \
        --header "Content-Type: $content_type" \
        --output /dev/null \
        "$(spaces_url "$key")"
    verify_remote_bytes "$file" "$key"
}

require_current_channel_unchanged() {
    local downloaded
    downloaded="$(mktemp)"
    if [[ "$expect_current_absent" == "true" ]]; then
        local status
        status="$(spaces_curl \
            --output "$downloaded" \
            --write-out '%{http_code}' \
            "$(spaces_url "channels/$channel.json")" 2>/dev/null || true)"
        rm -f "$downloaded"
        if [[ "$status" != "404" ]]; then
            printf 'error: expected %s channel metadata to be absent; found HTTP %s\n' \
                "$channel" "${status:-unknown}" >&2
            exit 1
        fi
        return
    fi
    if ! download_object "channels/$channel.json" "$downloaded"; then
        rm -f "$downloaded"
        printf 'error: could not read the current %s channel metadata\n' "$channel" >&2
        exit 1
    fi
    if ! cmp -s "$expected_current_channel" "$downloaded"; then
        rm -f "$downloaded"
        printf 'error: %s channel changed after publication preparation; refusing stale update\n' "$channel" >&2
        exit 1
    fi
    rm -f "$downloaded"
}

require_all_metadata_absent() {
    local downloaded key status
    for key in \
        "channels/$channel.json" \
        "channels/$channel.json.sig" \
        "releases/$channel.json" \
        "releases/$channel.json.sig"; do
        downloaded="$(mktemp)"
        status="$(spaces_curl \
            --output "$downloaded" \
            --write-out '%{http_code}' \
            "$(spaces_url "$key")" 2>/dev/null || true)"
        rm -f "$downloaded"
        if [[ "$status" != "404" ]]; then
            printf 'error: expected %s metadata to be absent at %s; found HTTP %s\n' \
                "$channel" "$key" "${status:-unknown}" >&2
            exit 1
        fi
    done
}

if [[ "$expect_current_absent" == "true" ]]; then
    require_all_metadata_absent
else
    require_current_channel_unchanged
fi
publish_metadata "$index_signature" "releases/$channel.json.sig" "text/plain"
publish_metadata "$index_json" "releases/$channel.json" "application/json"
require_current_channel_unchanged
publish_metadata "$channel_signature" "channels/$channel.json.sig" "text/plain"
publish_metadata "$channel_json" "channels/$channel.json" "application/json"

printf 'Changed signed %s channel metadata after immutable GitHub publication\n' "$channel"
