{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zolt.sh/schemas/channel-envelope-v1.schema.json",
  "title": "Zolt signed channel envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "signed",
    "signatures"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "sequence",
        "operation",
        "issuedAt",
        "expiresAt",
        "release"
      ],
      "properties": {
        "channel": {
          "enum": [
            "stable",
            "preview",
            "zap"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "enum": [
            "promote",
            "rollback"
          ]
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "previousEnvelopeSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "sourceRepository",
            "sourceCommit",
            "manifestUrl",
            "manifestSha256"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sourceRepository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "sourceCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "manifestUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "manifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "signature"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
