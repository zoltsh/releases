{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zolt.sh/schemas/release-index-v1.schema.json",
  "title": "Zolt release index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "updatedAt",
    "versions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "channel": {
      "enum": [
        "stable",
        "preview",
        "zap"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "commit",
          "createdAt",
          "artifacts"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-zap\\.[0-9]{8}\\.[0-9a-f]{12}|-(?:alpha|beta|rc)\\.(?:0|[1-9][0-9]*))?$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/artifact"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "stable" } } },
      "then": { "properties": { "versions": { "items": { "properties": { "version": { "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" } } } } } }
    },
    {
      "if": { "properties": { "channel": { "const": "preview" } } },
      "then": { "properties": { "versions": { "items": { "properties": { "version": { "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-(?:alpha|beta|rc)\\.(?:0|[1-9][0-9]*)$" } } } } } }
    },
    {
      "if": { "properties": { "channel": { "const": "zap" } } },
      "then": { "properties": { "versions": { "items": { "properties": { "version": { "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-zap\\.[0-9]{8}\\.[0-9a-f]{12}$" } } } } } }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "archive",
        "archiveUrl",
        "checksumUrl",
        "sha256",
        "format",
        "binaryName"
      ],
      "properties": {
        "target": {
          "enum": [
            "linux-arm64",
            "linux-x64",
            "macos-arm64",
            "macos-x64"
          ]
        },
        "archive": {
          "type": "string",
          "pattern": "^zolt-.+-(?:linux-arm64|linux-x64|macos-arm64|macos-x64)\\.tar\\.gz$"
        },
        "archiveUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/zoltsh/releases/releases/download/zolt-(?:zap-|preview-v|v)[^/]+/"
        },
        "checksumUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/zoltsh/releases/releases/download/zolt-(?:zap-|preview-v|v)[^/]+/.+\\.sha256$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "const": "tar.gz"
        },
        "binaryName": {
          "const": "zolt"
        }
      }
    }
  }
}
